{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "União Paulista",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Introdução",
        "pages": [
          "introducao",
          "diretrizes",
          "responsaveis",
          "advertencias"
        ]
      },
      {
        "group": "Regras | União Paulista",
        "pages": [
          "gerais",
          "area-safe",
          "denuncias-e-provas",
          "discord",
          "policia",
          "armas-e-negociacao",
          {
            "group": "Regras・Ações Gerais",
            "pages": [
              "acoes-gerais/geral",
              "acoes-gerais/locais"
            ]
          },
          "perseguicao-e-fuga",
          "regras-resgate",
          "acoes-de-rua",
          "acoes-de-sequestro",
          "incursoes",
          "roubos",
          "blindados"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
